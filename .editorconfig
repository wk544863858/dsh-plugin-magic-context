# EditorConfig — https://editorconfig.org
# Last-resort defaults for editors that do not read the repository's own
# tooling config. Line endings are also enforced by .gitattributes; both
# files must agree (LF everywhere, CRLF only for Windows batch files).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown keeps trailing whitespace (significant as a hard line break).
[*.md]
trim_trailing_whitespace = false

# Windows batch files must be CRLF; cmd.exe mis-parses LF-only scripts in
# some paths, and the hand-out installer is a .bat.
[*.{bat,cmd}]
end_of_line = crlf

# PowerShell is LF-friendly; keep it LF like the rest of the tree.
[*.ps1]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{ts,mts,cts,js,mjs}]
indent_size = 2

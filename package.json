{
  "name": "@cortexkit/dsh-magic-context",
  "version": "0.2.0",
  "private": true,
  "description": "Magic Context for DeepSeek Harness: reversible context reclaim, an out-of-band historian, an m[0]/m[1] baseline, shared project memories, and the compaction seam.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-client.mjs",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/mc-i18n-check.mjs",
    "check:specs": "node scripts/sync-specs.mjs --check",
    "sync:specs": "node scripts/sync-specs.mjs",
    "test": "node scripts/mc-test.mjs --quick",
    "test:full": "node scripts/mc-test.mjs --full",
    "bootstrap:testhost": "node scripts/bootstrap-testhost.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@huggingface/transformers": "4.3.0",
    "onnxruntime-node": "1.30.0"
  }
}

# Dependencies (npm; the lockfile is committed)
node_modules/

# Build output (tsc -p tsconfig.build.json + copy-client). Rebuild with `npm run build`.
# Anchored: a bare `lib/` matches at ANY depth, and silently swallowed
# scripts/lib/ (a hand-written module that must be committed) on 2026-10-10.
/lib/

# Test/coverage residue
coverage/

# Local scratch: extracted snapshots, keep-out areas, throwaway databases
.tmp-*/

# Upstream Magic Context source, pulled for read-only analysis (never committed)
.upstream/

# Logs
*.log
npm-debug.log*
